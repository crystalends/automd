{
  "name": "automd-static-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-css.mjs && node scripts/build-js.mjs",
    "audit": "node scripts/audit-project.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "clean:assets": "node scripts/audit-assets.mjs --delete",
    "fix:image-dimensions": "node scripts/add-image-dimensions.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run audit && npm run audit:assets && npm test"
  }
}
